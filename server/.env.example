# ==========================================
# MongoDB & Backend Environment Variables
# ==========================================

# Port for the Node.js / Express backend
PORT=5000

# MongoDB Connection String:
# Option 1: Local MongoDB (Default)
MONGODB_URI=mongodb://127.0.0.1:27017/ai-student-career-guide

# Option 2: MongoDB Atlas (Cloud Database)
# Replace <username>, <password>, and <cluster-url> with your MongoDB Atlas details:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/ai-student-career-guide?retryWrites=true&w=majority

# JWT Authentication Secret Key (Any random secure string)
JWT_SECRET=ai_career_guide_secret_token_123456

# Optional: Google Gemini API Key (for live AI question generation & resume scanning)
# GEMINI_API_KEY=your_gemini_api_key_here
